# =============================================================================
# TPQ Futuhil Hidayah — Environment Variables
# Salin file ini ke .env.local dan isi nilainya sebelum menjalankan aplikasi.
# JANGAN pernah meng-commit file .env.local ke repository.
# =============================================================================

# ----- Node Environment -----
NODE_ENV=development

# ----- Database (MySQL) -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tpq_futuhil
DB_USER=root
DB_PASSWORD=your_db_password
# Aktifkan SSL untuk koneksi database produksi
DB_SSL=false
# DB_SSL_CA=/path/to/ca-cert.pem

# ----- JWT Authentication -----
JWT_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter
JWT_EXPIRES_IN=7d

# ----- CORS / Allowed Origins -----
# Pisahkan beberapa origin dengan koma, misal: https://tpq.example.com,https://admin.tpq.example.com
ALLOWED_ORIGINS=http://localhost:3000

# ----- Developer Secret (untuk akses khusus dev, jangan diisi di produksi) -----
# DEV_SECRET=

# ----- Email — SMTP Utama -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=akun@gmail.com
SMTP_PASS=app_password_gmail
SMTP_FROM=TPQ Futuhil Hidayah <akun@gmail.com>

# ----- Email — Gmail (alias SMTP_*) -----
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_SECURE=false
GMAIL_EMAIL=akun@gmail.com
GMAIL_PASSWORD=app_password_gmail
GMAIL_FROM=TPQ Futuhil Hidayah <akun@gmail.com>
EMAIL_FROM=TPQ Futuhil Hidayah <akun@gmail.com>

# ----- Email — Outlook / Office 365 -----
# OUTLOOK_SMTP_HOST=smtp.office365.com
# OUTLOOK_SMTP_PORT=587
# OUTLOOK_SMTP_SECURE=false
# OUTLOOK_EMAIL=akun@outlook.com
# OUTLOOK_PASSWORD=password_outlook

# ----- Email — SMTP Kedua (opsional) -----
# SMTP2_HOST=
# SMTP2_PORT=587
# SMTP2_SECURE=false
# SMTP2_USER=
# SMTP2_PASS=
